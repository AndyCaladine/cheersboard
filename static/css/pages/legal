/* ============================================================
   CheersBoard — Legal Pages (Privacy Policy, Terms)
   ============================================================ */

.page--legal {
    background: var(--color-navy);
    min-height: 100vh;
}

.legal {
    padding: calc(var(--nav-height) + 3rem) 1.25rem 5rem;
}

.legal__inner {
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
}

/* ============================================================
   Header
   ============================================================ */

.legal__header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.legal__title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-white);
    margin: 0 0 0.5rem;
}

.legal__meta {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
}

/* ============================================================
   Body
   ============================================================ */

.legal__body {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9375rem;
    line-height: 1.8;
}

.legal__body h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-white);
    margin: 2.5rem 0 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
}

.legal__body p {
    margin: 0 0 1rem;
}

.legal__body ol,
.legal__body ul {
    margin: 0.5rem 0 1rem 1.5rem;
    padding: 0;
}

.legal__body li {
    margin-bottom: 0.5rem;
}

.legal__body a {
    color: var(--color-yellow);
    text-decoration: underline;
    text-underline-offset: 2px;
}

.legal__body a:hover {
    opacity: 0.8;
}

.legal__body strong {
    color: var(--color-white);
    font-weight: 600;
}

/* ============================================================
   Table (definitions)
   ============================================================ */

.legal__table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.9rem;
}

.legal__table td {
    padding: 0.75rem 1rem;
    vertical-align: top;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
}

.legal__table td:first-child {
    width: 220px;
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.04);
    white-space: nowrap;
}

/* ============================================================
   Date
   ============================================================ */

.legal__date {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.35);
}